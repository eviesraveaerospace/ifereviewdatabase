# Required for crawling (daily_crawl.py, dashboard Crawl button, gather_*.py)
YOUTUBE_API_KEY=your_api_key_here

# Optional: Ask AI tab in the dashboard
ANTHROPIC_API_KEY=

# Optional but needed for the nightly transcript grind: base64 of a Netscape
# cookies.txt exported from a browser signed in to YouTube. Without it, YouTube
# bot-blocks anonymous transcript/audio requests from most fixed IPs.
#   python -c "import base64;print(base64.b64encode(open('cookies.txt','rb').read()).decode())"
YOUTUBE_COOKIES_B64=

# Optional: Whisper model size for local transcription (tiny/base/small/medium)
WHISPER_MODEL=base
